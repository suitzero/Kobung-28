# Copy to .env and fill in. .env is gitignored — never commit real secrets.

GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Hugging Face token with read access to the model repo (huggingface.co/settings/tokens)
HF_TOKEN=

# Bearer key clients must send to query the server. Leave blank and deploy.sh
# will generate a random one for you.
VLLM_API_KEY=

# CIDR allowed to reach SSH + the API, e.g. 203.0.113.4/32. Leave blank and
# deploy.sh will auto-detect your current public IP.
ALLOWED_IP=

# a2-ultragpu-8g = 8x A100 80GB. Smaller shapes (a2-ultragpu-4g/2g/1g) cost
# less but must be able to hold the full model + KV cache.
MACHINE_TYPE=a2-ultragpu-8g
TENSOR_PARALLEL_SIZE=8
USE_SPOT=true
