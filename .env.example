# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Minimum required: just VAST_API_KEY. Everything else has a working default.

# Get one at https://cloud.vast.ai/manage-keys/
VAST_API_KEY=

# Pre-quantized GGUF checkpoint to serve (~110GB, validated on llama.cpp).
# Leave as-is unless you want a different quant/quality tradeoff — see
# README for alternatives (bigger = better quality, needs more GPU VRAM).
HF_REPO=apetersson/DeepSeek-V4-Flash-0731-Abliterated-DS4-Quality128

# Only needed if HF_REPO is gated.
HF_TOKEN=

# Bearer key clients must send to query the server. Leave blank and
# deploy.sh will generate a random one for you.
LLAMA_API_KEY=

# GPUs to rent on vast.ai. Default is 1x H200 (140GB VRAM) — the whole
# model fits on a single card with ~30GB to spare, no multi-GPU tensor
# split needed. See README for alternatives (cheaper, or more headroom).
GPU_NAME=H200
NUM_GPUS=1

# false (default, recommended) = server is only reachable via an SSH tunnel
# (private, single-user). true = also map the port publicly (still gated
# by LLAMA_API_KEY, but reachable by anyone who has the key).
PUBLIC_EXPOSE=false
