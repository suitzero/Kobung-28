# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# Restrict access to yourself only, e.g. "203.0.113.4/32"
allowed_ip = "0.0.0.0/32"

machine_type          = "a2-ultragpu-8g" # 8x A100 80GB
tensor_parallel_size  = 8
use_spot              = true

hf_token = "hf_xxx"
api_key  = "change-me-to-a-long-random-string"
